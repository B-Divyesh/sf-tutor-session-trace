{
  "properties": {
    "configuration": {
      "activeRevisionsMode": "Single"
    },
    "template": {
      "containers": [
        {
          "name": "app",
          "image": "sociobotregistry.azurecr.io/sf-tutor-session-trace:IMAGE_TAG",
          "env": [
            {
              "name": "PORT",
              "value": "8080"
            },
            {
              "name": "DATABASE_URL",
              "value": "sqlite:///data/trace.db?mode=rwc&vfs=unix-dotfile"
            }
          ],
          "resources": {
            "cpu": 0.5,
            "memory": "1Gi"
          },
          "volumeMounts": [
            {
              "volumeName": "data",
              "mountPath": "/data"
            }
          ]
        }
      ],
      "scale": {
        "minReplicas": 1,
        "maxReplicas": 1
      },
      "volumes": [
        {
          "name": "data",
          "storageName": "data-tutor-session-trace",
          "storageType": "AzureFile"
        }
      ]
    }
  }
}
